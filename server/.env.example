# ---- Server ----
PORT=8787
# Long random string. The PHARMA app sends it as the x-api-key header.
PHARMA_API_KEY=change-me-to-a-long-random-string
# Comma-separated browser origins allowed to call this server.
ALLOWED_ORIGINS=https://rinapharma.netlify.app,https://localhost,capacitor://localhost,http://localhost:5173
# Public https URL of THIS server (used for webhook + return URLs).
PUBLIC_BASE_URL=https://your-payments-server.onrender.com
# Where to keep the transaction ledger (use a persistent disk if you have one).
DATA_DIR=./data

# ---- Flutterwave (mobile money MTN/Airtel, card, bank) ----
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx-X
# The "Secret hash" you set in Flutterwave Dashboard > Settings > Webhooks.
FLW_SECRET_HASH=another-long-random-string
FLW_HOSTED_OPTIONS=card,mobilemoneyuganda,banktransfer
# Minutes before an unanswered mobile-money prompt is reported as TIMEOUT.
MM_TIMEOUT_MINUTES=4
HOSTED_TIMEOUT_MINUTES=30

# ---- PayPal ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_WEBHOOK_ID=            # optional but recommended
PAYPAL_UGX_PER_USD=3700       # PayPal cannot charge UGX, so amounts are converted

# ---- AI assistant (online mode) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
